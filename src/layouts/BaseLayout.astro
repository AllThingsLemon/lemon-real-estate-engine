---
import '../styles/global.css';
import { FundIsland } from '@engine/fund';
import Icon from '../components/Icon.astro';
import { getGeneral, getPages, href, isExternal, fontsHref } from '../lib/site';

interface Props { title?: string; description?: string; image?: string; noindex?: boolean }
const { title, description, image, noindex } = Astro.props;
const s = await getGeneral();
const t = s.theme;
const pageTitle = title ? `${title} | ${s.siteName}` : s.siteName;
const desc = description || s.description;
const og = image || s.ogImage;
const ogUrl = og && Astro.site ? new URL(og, Astro.site).href : og;
const fonts = fontsHref(t.font, t.headingFont);
const path = Astro.url.pathname;

// Footer links default to every visible page if the client hasn't listed any.
const footerLinks = s.footer.links.length
  ? s.footer.links
  : (await getPages()).filter((p) => p.id !== 'about').map((p) => ({ label: p.data.title, url: `/${p.id}/` }));

// Client-entered values go into CSS, so strip anything that could break out of it.
// Blank values are left out so global.css's defaults apply.
const css = (v: unknown) => String(v ?? '').replace(/[^#\w\s(),.%-]/g, '').trim();
const font = css(t.font);
const headingFont = css(t.headingFont);
const themeVars = {
  accent: css(t.accent), text: css(t.text), bg: css(t.background), surface: css(t.surface), footer: css(t.footer),
  font: font && `'${font}',system-ui,sans-serif`,
  'heading-font': headingFont && `'${headingFont}',var(--font)`,
  'logo-h': `${Number(s.logoHeight) || 40}px`,
};
// A dark background marks the page data-theme="dark", so status colours that
// can't be mixed from the theme alone (fund.css) switch to lighter shades.
const isDark = (c: string) => {
  const hex = c.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i)?.[1];
  const rgb = hex
    ? (hex.length === 3 ? [...hex].map((h) => h + h) : hex.match(/../g)!).map((h) => parseInt(h, 16))
    : c.match(/^rgba?\(\s*(\d+)[\s,]+(\d+)[\s,]+(\d+)/i)?.slice(1, 4).map(Number);
  if (!rgb) return false;
  const [r, g, b] = rgb.map((v) => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b < 0.179; // white text reads better than black
};
const dark = isDark(themeVars.bg);
// html:root outranks the :root defaults in global.css, which Astro links after this tag.
const themeCss = `html:root{${Object.entries(themeVars).filter(([, v]) => v).map(([k, v]) => `--${k}:${v}`).join(';')}}`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en" data-theme={dark ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {desc && <meta name="description" content={desc} />}
    {noindex && <meta name="robots" content="noindex" />}
    {Astro.site && <link rel="canonical" href={new URL(path, Astro.site).href} />}
    {s.favicon && <link rel="icon" href={s.favicon} />}
    <meta property="og:title" content={pageTitle} />
    {desc && <meta property="og:description" content={desc} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    {fonts && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {fonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fonts && <link rel="stylesheet" href={fonts} />}
    <style is:inline set:html={themeCss}></style>
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label={`${s.siteName} home`}>
          {s.logo ? <img src={s.logo} alt={s.siteName} /> : <span>{s.siteName}</span>}
        </a>
        {s.nav.length > 0 && (
          <>
            <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle menu">
              <Icon name="menu" />
            </button>
            <nav id="site-nav" class="nav" aria-label="Main">
              {s.nav.map((l) => (
                <a href={href(l.url)} aria-current={href(l.url) === path ? 'page' : undefined}
                   {...(isExternal(l.url) ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
              ))}
            </nav>
          </>
        )}
        {/* Wallet pages bring their own; on fund sites every other page gets the header's (nothing elsewhere). */}
        {Astro.slots.has('header-end') ? <slot name="header-end" /> : <FundIsland />}
      </div>
    </header>
    <slot name="before-main" />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        {(s.footer.noticeTitle || s.footer.noticeText) && (
          <section class="notice">
            {s.footer.noticeTitle && <h2>{s.footer.noticeTitle}</h2>}
            {s.footer.noticeText && <p>{s.footer.noticeText}</p>}
          </section>
        )}
        {footerLinks.length > 0 && (
          <ul class="footer-links">
            {footerLinks.map((l) => <li><a href={href(l.url)}>{l.label}</a></li>)}
          </ul>
        )}
      </div>
      <div class="copyright">
        <div class="container">{s.footer.copyright ? s.footer.copyright.replace('{year}', String(year)) : `© ${year} ${s.siteName}. All rights reserved.`}</div>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('site-nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open') ?? false;
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
