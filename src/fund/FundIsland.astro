---
// Puts the wallet island in the header. Pages import it as "@engine/fund-island",
// which astro.config.mjs points here only on sites with a "fund" block, and at
// NoFund.astro otherwise, so other clients' builds never include React or the
// wallet code.
import './fund.css';
import WalletIsland from './WalletIsland';
import { config, getGeneral } from '../lib/site';

interface Props {
  /** The listing's project address, on a listing linked to one: adds the invest panel. */
  project?: `0x${string}`;
}
const { project } = Astro.props;
const s = await getGeneral();
const fund = config.fund;
const link = fund && project
  ? { project, factories: fund.factories, lens: fund.lens, trustedOwners: fund.trustedOwners }
  : undefined;
---
{fund && (
  <div class="wallet-slot">
    <WalletIsland
      client:only="react"
      chainId={fund.chainId}
      walletConnectProjectId={fund.walletConnectProjectId}
      appName={s.siteName}
      appIcon={s.favicon || s.logo}
      accent={s.theme.accent}
      link={link}
    />
  </div>
)}
