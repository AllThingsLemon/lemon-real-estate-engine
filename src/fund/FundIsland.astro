---
// Puts the wallet island in the header: the Connect button, and the Manage
// link for wallets that run one of this site's projects. On a linked listing
// it also fills the invest panel, on /portfolio/ the investor's positions,
// and on /manage/ the manage pages (all through portals). Elsewhere it loads
// once the page is idle. BaseLayout puts it on every page of a fund site;
// pages import it from "@engine/fund" (see index.ts) to pass more.
import './fund.css';
import WalletIsland from './WalletIsland';
import WalletLazy from './WalletLazy';
import type { Listing } from './queries';
import { linkedListings, unlinkedListings } from './listings';
import { config, getGeneral, getInvesting } from '../lib/site';

interface Props {
  /** On a listing linked to a project. */
  listing?: Listing;
  /** On /portfolio/. */
  portfolio?: boolean;
  /** On /manage/. */
  manage?: boolean;
}
const { listing, portfolio, manage } = Astro.props;
const s = await getGeneral();
const fund = config.fund!;
const disclosures = await getInvesting();
// Hidden listings too: their projects still have investors and upkeep.
const sites = await linkedListings();
const props = {
  chainId: fund.chainId,
  walletConnectProjectId: fund.walletConnectProjectId,
  appName: s.siteName,
  appIcon: s.favicon || s.logo,
  accent: s.theme.accent,
  trust: { factories: fund.factories, lens: fund.lens, trustedOwners: fund.trustedOwners },
  owners: fund.owners,
  disclosures,
  portfolioUrl: '/portfolio/',
  sites,
  // /manage/ links new projects to listings through the editor.
  editor: manage ? { url: '/admin/', listings: await unlinkedListings() } : null,
  indexerUrl: fund.indexerUrl,
  listing,
  portfolio,
  manage,
};
const onChain = Boolean(listing || portfolio || manage);
---
<div class="wallet-slot">
  {onChain ? <WalletIsland client:only="react" {...props} /> : <WalletLazy client:only="react" {...props} />}
</div>
